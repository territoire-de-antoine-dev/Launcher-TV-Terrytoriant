<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:orientation="vertical"
    android:paddingLeft="25dp"
    android:paddingTop="15dp"
    android:paddingRight="25dp">

    <!-- Navigation qui reste visible en haut -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navBackground"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tabRow"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="6dp" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/searchButton"
                android:layout_width="43dp"
                android:layout_height="42dp"
                android:clickable="true"
                android:contentDescription="Chercher une application"
                android:focusable="true"
                android:gravity="center"
                android:text="⌕"
                android:textColor="#252A32"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/settingsButton"
                android:layout_width="43dp"
                android:layout_height="42dp"
                android:clickable="true"
                android:contentDescription="Réglages du launcher"
                android:focusable="true"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#252A32"
                android:textSize="23sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/clockWeather"
            android:layout_width="169dp"
            android:layout_height="49dp"
            android:clickable="true"
            android:contentDescription="Heure et météo. Appuyer pour choisir la ville."
            android:focusable="true"
            android:gravity="center"
            android:maxLines="2"
            android:text="--:--&#10;Choisir une ville"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/logoBox"
            android:layout_width="52dp"
            android:layout_height="49dp"
            android:clickable="true"
            android:contentDescription="Changer le logo"
            android:focusable="true">

            <TextView
                android:id="@+id/defaultLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E60012"
                android:gravity="center"
                android:text="TV"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/customLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Logo personnalisé"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Le contenu change selon l'onglet -->
    <ScrollView
        android:id="@+id/pageScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:focusable="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/pageContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="30dp" />
    </ScrollView>
</LinearLayout>
